DJANGO_DEBUG=true
VOTRIA_DEMO_MODE=true
DJANGO_SECRET_KEY=replace-with-a-random-local-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
# The deployment's default institution. Its members sign in with an address on this domain
# (for example, example.org). Demo accounts are created on the same domain.
VOTRIA_INSTITUTION_NAME=
VOTRIA_ALLOWED_EMAIL_DOMAIN=
# Days before apply_retention purges proxy codes, session identifiers and idempotency receipts.
VOTRIA_RETENTION_DAYS=365
VOTRIA_REQUIRED_ACR=
VOTRIA_DEMO_ACCESS_PASSWORD=
DATABASE_URL=
# Optional SQLite file for local runs (the end-to-end tests use e2e.sqlite3).
DJANGO_SQLITE_PATH=
POSTGRES_HOST=
POSTGRES_DB=votria
POSTGRES_USER=votria
POSTGRES_PASSWORD=
